# Maintainer: Your Name <your.email@example.com>

pkgname=gweather-add-loc
pkgver=0.1.4
pkgrel=1
pkgdesc="Add custom locations with arbitrary coordinates to GNOME Weather"
arch=('x86_64')
url="https://github.com/crian/gweather-add-loc"
license=('MIT')

depends=(
    'gtk4'
    'libadwaita'
    'glibc'
    'gcc-libs'
    'glib2'
    'gawk'
    'procps-ng'
)

makedepends=(
    'cargo'
    'pkgconf'
)

optdepends=(
    'gnome-weather: the app these locations are added to'
    'flatpak: support for Flatpak installations of GNOME Weather'
)

source=(
    "$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz"
)

sha256sums=('4cd16616b8cb06880e9830ac24b319077ea6aaa007f5c2d9760fdabdddb9de89')

prepare() {
    cd "$pkgname-$pkgver"

    export RUSTUP_TOOLCHAIN=stable
    export CARGO_HOME="$srcdir/cargo-home"

    cargo fetch --locked
}

build() {
    cd "$pkgname-$pkgver"

    export RUSTUP_TOOLCHAIN=stable
    export CARGO_HOME="$srcdir/cargo-home"

    cargo build --frozen --release
}

package() {
    cd "$pkgname-$pkgver"

    # Main application
    install -Dm755 "target/release/$pkgname" \
        "$pkgdir/usr/bin/$pkgname"

    # Bash helper script
    install -Dm755 "gweather-add-loc.sh" \
        "$pkgdir/usr/bin/gweather-add-loc.sh"

    # Desktop entry
    install -Dm644 \
        "data/io.github.crian.GWeatherAddLoc.desktop" \
        "$pkgdir/usr/share/applications/io.github.crian.GWeatherAddLoc.desktop"

    # AppStream metadata
    install -Dm644 \
        "data/io.github.crian.GWeatherAddLoc.metainfo.xml" \
        "$pkgdir/usr/share/metainfo/io.github.crian.GWeatherAddLoc.metainfo.xml"

    # Application icon
    install -Dm644 \
        "data/icons/hicolor/scalable/apps/io.github.crian.GWeatherAddLoc.svg" \
        "$pkgdir/usr/share/icons/hicolor/scalable/apps/io.github.crian.GWeatherAddLoc.svg"

    # Symbolic application icon
    install -Dm644 \
        "data/icons/hicolor/symbolic/apps/io.github.crian.GWeatherAddLoc-symbolic.svg" \
        "$pkgdir/usr/share/icons/hicolor/symbolic/apps/io.github.crian.GWeatherAddLoc-symbolic.svg"

    # License
    install -Dm644 LICENSE \
        "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
